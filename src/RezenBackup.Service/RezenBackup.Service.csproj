<Project Sdk="Microsoft.NET.Sdk.Worker">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <AssemblyName>RezenBackupService</AssemblyName>
    <RootNamespace>RezenBackup.Service</RootNamespace>
    <!-- Windows-only component; it compiles everywhere so CI on any OS checks it. -->
    <NoWarn>$(NoWarn);CA1416</NoWarn>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Hosting" />
    <PackageReference Include="Microsoft.Extensions.Hosting.WindowsServices" />
    <PackageReference Include="System.Management" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\RezenBackup.Platform\RezenBackup.Platform.csproj" />
  </ItemGroup>
</Project>
