<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:RezenBackup.UI.ViewModels"
             x:Class="RezenBackup.UI.Views.RestoreView"
             x:DataType="vm:RestoreViewModel">
  <Grid RowDefinitions="Auto,*" Margin="32,28,32,20">
    <StackPanel Spacing="10">
      <Grid ColumnDefinitions="*,Auto">
        <TextBlock Text="Restore" Classes="h1" />
        <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8">
          <TextBlock Text="Backup job" Classes="label" VerticalAlignment="Center" />
          <ComboBox ItemsSource="{Binding Jobs}" SelectedItem="{Binding SelectedJob}" Width="260" />
        </StackPanel>
      </Grid>
      <Border Classes="banner-warn" IsVisible="{Binding Message, Converter={x:Static ObjectConverters.IsNotNull}}">
        <TextBlock Text="{Binding Message}" TextWrapping="Wrap" />
      </Border>
      <StackPanel Orientation="Horizontal" Spacing="10" IsVisible="{Binding IsBusy}">
        <ProgressBar IsIndeterminate="{Binding !HasProgress}" Value="{Binding Progress}" Width="240" />
        <TextBlock Text="{Binding BusyText}" Classes="muted" VerticalAlignment="Center" />
        <TextBlock Text="{Binding ProgressText}" Classes="muted" VerticalAlignment="Center" />
      </StackPanel>
    </StackPanel>

    <!-- Locked -->
    <Border Grid.Row="1" Classes="card" IsVisible="{Binding !IsUnlocked}" VerticalAlignment="Top" Margin="0,16,0,0" MaxWidth="560" HorizontalAlignment="Left">
      <StackPanel Spacing="12">
        <StackPanel Orientation="Horizontal" Spacing="10">
          <PathIcon Data="{StaticResource IconLock}" Width="22" Height="22" Classes="accent" />
          <TextBlock Text="Backup Locked" Classes="h2" />
        </StackPanel>
        <TextBlock Classes="muted" TextWrapping="Wrap" Text="Your backup history, file names and versions stay encrypted until you unlock with your password or recovery key." />
        <Button Classes="primary" Content="Unlock" Command="{Binding UnlockCommand}" HorizontalAlignment="Left" />
      </StackPanel>
    </Border>

    <!-- Unlocked -->
    <Grid Grid.Row="1" ColumnDefinitions="300,16,*,16,280" IsVisible="{Binding IsUnlocked}" Margin="0,16,0,0">
      <!-- Snapshots -->
      <Border Classes="card" Padding="8">
        <DockPanel>
          <TextBlock DockPanel.Dock="Top" Text="Backup dates" Classes="h3" Margin="10,6,10,8" />
          <ListBox ItemsSource="{Binding Snapshots}" SelectedItem="{Binding SelectedSnapshot}" Background="Transparent">
            <ListBox.ItemTemplate>
              <DataTemplate x:DataType="vm:SnapshotItem">
                <StackPanel Margin="2">
                  <TextBlock Text="{Binding Title}" FontWeight="SemiBold" TextWrapping="Wrap" />
                  <TextBlock Text="{Binding Subtitle}" Classes="label" Classes.bad="{Binding !Restorable}" />
                </StackPanel>
              </DataTemplate>
            </ListBox.ItemTemplate>
          </ListBox>
        </DockPanel>
      </Border>

      <!-- Browser -->
      <Border Grid.Column="2" Classes="card" Padding="12">
        <DockPanel>
          <StackPanel DockPanel.Dock="Top" Spacing="8">
            <WrapPanel>
              <TextBox Text="{Binding SearchText}" Watermark="Search file or folder name" Width="220" Margin="0,0,8,6" />
              <TextBox Text="{Binding ExtensionFilter}" Watermark="Extension" Width="100" Margin="0,0,8,6" />
              <CalendarDatePicker SelectedDate="{Binding ModifiedFrom, Mode=TwoWay}" Watermark="Modified from" Width="150" Margin="0,0,8,6" />
              <CalendarDatePicker SelectedDate="{Binding ModifiedTo, Mode=TwoWay}" Watermark="to" Width="130" Margin="0,0,8,6" />
              <Button Content="Search" Command="{Binding SearchCommand}" Margin="0,0,8,6" />
              <Button Content="Clear" Command="{Binding ClearSearchCommand}" Margin="0,0,0,6" />
            </WrapPanel>
            <Grid ColumnDefinitions="Auto,*">
              <Button Content="↑ Up" Command="{Binding UpCommand}" />
              <TextBlock Grid.Column="1" Text="{Binding Breadcrumb}" Classes="muted" Margin="10,0" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
            </Grid>
          </StackPanel>
          <Border DockPanel.Dock="Bottom" BorderBrush="{DynamicResource RzCardBorder}" BorderThickness="0,1,0,0" Padding="0,10,0,0" Margin="0,8,0,0">
            <StackPanel Spacing="8">
              <StackPanel Orientation="Horizontal" Spacing="16">
                <RadioButton GroupName="target" Content="Restore to original location" IsChecked="{Binding RestoreToOriginal}" />
                <RadioButton GroupName="target" Content="Restore to another location" IsChecked="{Binding !RestoreToOriginal}" />
                <Button Content="Choose folder…" Command="{Binding ChooseTargetCommand}" />
              </StackPanel>
              <TextBlock Text="{Binding TargetFolder}" Classes="label" IsVisible="{Binding !RestoreToOriginal}" />
              <StackPanel Orientation="Horizontal" Spacing="8">
                <Button Classes="primary" Content="Restore Selected" Command="{Binding RestoreSelectedCommand}" IsEnabled="{Binding !IsBusy}" />
                <Button Content="Restore Entire Snapshot" Command="{Binding RestoreSnapshotCommand}" IsEnabled="{Binding !IsBusy}" />
              </StackPanel>
            </StackPanel>
          </Border>
          <ListBox x:Name="Browser" ItemsSource="{Binding Items}" SelectedItem="{Binding SelectedItem}" Background="Transparent" DoubleTapped="OnBrowserDoubleTapped">
            <ListBox.ItemTemplate>
              <DataTemplate x:DataType="vm:BrowserItem">
                <Grid ColumnDefinitions="Auto,Auto,*,110,150">
                  <CheckBox IsChecked="{Binding IsChecked}" Margin="0,0,6,0" />
                  <PathIcon Grid.Column="1" Data="{StaticResource IconFolder}" Width="16" Height="16" Classes="accent" IsVisible="{Binding IsDirectory}" />
                  <PathIcon Grid.Column="1" Data="{StaticResource IconFile}" Width="16" Height="16" Classes="accent" IsVisible="{Binding !IsDirectory}" />
                  <StackPanel Grid.Column="2" Margin="10,0">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                      <TextBlock Text="{Binding Name}" TextTrimming="CharacterEllipsis" />
                      <TextBlock Text="{Binding Badge}" Classes="warn label" />
                    </StackPanel>
                    <TextBlock Text="{Binding PathText}" Classes="label" TextTrimming="CharacterEllipsis" IsVisible="{Binding ShowPath}" />
                  </StackPanel>
                  <TextBlock Grid.Column="3" Text="{Binding SizeText}" Classes="muted" HorizontalAlignment="Right" VerticalAlignment="Center" />
                  <TextBlock Grid.Column="4" Text="{Binding ModifiedText}" Classes="label" HorizontalAlignment="Right" VerticalAlignment="Center" />
                </Grid>
              </DataTemplate>
            </ListBox.ItemTemplate>
          </ListBox>
        </DockPanel>
      </Border>

      <!-- Versions -->
      <Border Grid.Column="4" Classes="card" Padding="12">
        <DockPanel>
          <TextBlock DockPanel.Dock="Top" Text="Versions" Classes="h3" Margin="4,2,4,8" />
          <TextBlock DockPanel.Dock="Top" Text="Select a file to see every version kept in your backups." Classes="label" TextWrapping="Wrap" IsVisible="{Binding !HasVersions}" Margin="4,0" />
          <ItemsControl ItemsSource="{Binding Versions}">
            <ItemsControl.ItemTemplate>
              <DataTemplate x:DataType="vm:VersionItem">
                <Border Classes="tile" Margin="0,0,0,8" Padding="10">
                  <StackPanel Spacing="4">
                    <TextBlock Text="{Binding Title}" FontWeight="SemiBold" />
                    <TextBlock Text="{Binding Detail}" Classes="label" TextWrapping="Wrap" />
                    <Button Content="Restore this version" Classes="link" Command="{Binding $parent[UserControl].((vm:RestoreViewModel)DataContext).RestoreVersionCommand}" CommandParameter="{Binding}" />
                  </StackPanel>
                </Border>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </DockPanel>
      </Border>
    </Grid>
  </Grid>
</UserControl>
