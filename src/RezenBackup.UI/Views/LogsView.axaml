<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:RezenBackup.UI.ViewModels"
             x:Class="RezenBackup.UI.Views.LogsView"
             x:DataType="vm:LogsViewModel">
  <DockPanel Margin="36,32">
    <Grid DockPanel.Dock="Top" ColumnDefinitions="*,Auto,Auto" Margin="0,0,0,16">
      <TextBlock Text="Logs" Classes="h1" />
      <ComboBox Grid.Column="1" ItemsSource="{Binding Files}" SelectedItem="{Binding SelectedFile}" Width="260" Margin="0,0,8,0" />
      <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="8">
        <Button Content="Refresh" Command="{Binding RefreshCommand}" />
        <Button Content="Open Folder" Command="{Binding OpenFolderCommand}" />
      </StackPanel>
    </Grid>
    <TextBlock DockPanel.Dock="Top" Classes="label" Margin="0,0,0,8" TextWrapping="Wrap"
               Text="Logs stay on this computer. They never contain passwords, keys or file contents; file names are hidden unless you turn that off in Settings." />
    <Border Classes="card" Padding="12">
      <ScrollViewer HorizontalScrollBarVisibility="Auto">
        <SelectableTextBlock Text="{Binding Content}" FontFamily="Menlo, Consolas, Courier New, monospace" FontSize="12" />
      </ScrollViewer>
    </Border>
  </DockPanel>
</UserControl>
