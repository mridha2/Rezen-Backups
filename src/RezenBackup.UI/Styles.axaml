<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

  <Style Selector="Window">
    <Setter Property="Background" Value="{DynamicResource RzWindowBg}" />
  </Style>

  <Style Selector="TextBlock">
    <Setter Property="Foreground" Value="{DynamicResource RzText}" />
  </Style>
  <Style Selector="TextBlock.h1">
    <Setter Property="FontSize" Value="28" />
    <Setter Property="FontWeight" Value="SemiBold" />
  </Style>
  <Style Selector="TextBlock.h2">
    <Setter Property="FontSize" Value="20" />
    <Setter Property="FontWeight" Value="SemiBold" />
  </Style>
  <Style Selector="TextBlock.h3">
    <Setter Property="FontSize" Value="15" />
    <Setter Property="FontWeight" Value="SemiBold" />
  </Style>
  <Style Selector="TextBlock.muted">
    <Setter Property="Foreground" Value="{DynamicResource RzMuted}" />
  </Style>
  <Style Selector="TextBlock.label">
    <Setter Property="Foreground" Value="{DynamicResource RzMuted}" />
    <Setter Property="FontSize" Value="12" />
  </Style>
  <Style Selector="TextBlock.value">
    <Setter Property="FontSize" Value="15" />
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="Margin" Value="0,2,0,0" />
  </Style>
  <Style Selector="TextBlock.good">
    <Setter Property="Foreground" Value="{DynamicResource RzGood}" />
  </Style>
  <Style Selector="TextBlock.warn">
    <Setter Property="Foreground" Value="{DynamicResource RzWarn}" />
  </Style>
  <Style Selector="TextBlock.bad">
    <Setter Property="Foreground" Value="{DynamicResource RzBad}" />
  </Style>
  <Style Selector="TextBlock.mono">
    <Setter Property="FontFamily" Value="Menlo, Consolas, Courier New, monospace" />
  </Style>

  <Style Selector="Border.card">
    <Setter Property="Background" Value="{DynamicResource RzCardBg}" />
    <Setter Property="BorderBrush" Value="{DynamicResource RzCardBorder}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="14" />
    <Setter Property="Padding" Value="20" />
  </Style>
  <Style Selector="Border.tile">
    <Setter Property="Background" Value="{DynamicResource RzCardBg}" />
    <Setter Property="BorderBrush" Value="{DynamicResource RzCardBorder}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="12" />
    <Setter Property="Padding" Value="16" />
  </Style>
  <Style Selector="Border.banner-warn">
    <Setter Property="Background" Value="{DynamicResource RzWarnSoft}" />
    <Setter Property="CornerRadius" Value="10" />
    <Setter Property="Padding" Value="12,8" />
  </Style>
  <Style Selector="Border.banner-bad">
    <Setter Property="Background" Value="{DynamicResource RzBadSoft}" />
    <Setter Property="CornerRadius" Value="10" />
    <Setter Property="Padding" Value="12,8" />
  </Style>
  <Style Selector="Border.banner-good">
    <Setter Property="Background" Value="{DynamicResource RzGoodSoft}" />
    <Setter Property="CornerRadius" Value="10" />
    <Setter Property="Padding" Value="12,8" />
  </Style>
  <Style Selector="Border.banner-info">
    <Setter Property="Background" Value="{DynamicResource RzAccentSoft}" />
    <Setter Property="CornerRadius" Value="10" />
    <Setter Property="Padding" Value="12,8" />
  </Style>

  <Style Selector="Button">
    <Setter Property="CornerRadius" Value="8" />
    <Setter Property="Padding" Value="14,8" />
  </Style>
  <Style Selector="Button.primary">
    <Setter Property="Background" Value="{DynamicResource RzAccent}" />
    <Setter Property="Foreground" Value="White" />
    <Setter Property="FontWeight" Value="SemiBold" />
  </Style>
  <Style Selector="Button.primary:pointerover /template/ ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource SystemAccentColorDark1}" />
    <Setter Property="Foreground" Value="White" />
  </Style>
  <Style Selector="Button.big">
    <Setter Property="Padding" Value="28,14" />
    <Setter Property="FontSize" Value="16" />
    <Setter Property="CornerRadius" Value="10" />
  </Style>
  <Style Selector="Button.link">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="Foreground" Value="{DynamicResource RzAccent}" />
    <Setter Property="Padding" Value="0" />
    <Setter Property="BorderThickness" Value="0" />
  </Style>
  <Style Selector="Button.danger">
    <Setter Property="Foreground" Value="{DynamicResource RzBad}" />
  </Style>

  <Style Selector="ListBox.nav">
    <Setter Property="Background" Value="Transparent" />
  </Style>
  <Style Selector="ListBox.nav ListBoxItem">
    <Setter Property="CornerRadius" Value="8" />
    <Setter Property="Margin" Value="8,2" />
    <Setter Property="Padding" Value="12,10" />
  </Style>
  <Style Selector="ListBox.nav ListBoxItem:selected /template/ ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource RzNavSelected}" />
  </Style>

  <Style Selector="PathIcon.accent">
    <Setter Property="Foreground" Value="{DynamicResource RzAccent}" />
  </Style>
  <Style Selector="PathIcon.good">
    <Setter Property="Foreground" Value="{DynamicResource RzGood}" />
  </Style>
  <Style Selector="PathIcon.warn">
    <Setter Property="Foreground" Value="{DynamicResource RzWarn}" />
  </Style>
  <Style Selector="PathIcon.bad">
    <Setter Property="Foreground" Value="{DynamicResource RzBad}" />
  </Style>

  <Style Selector="ProgressBar">
    <Setter Property="Height" Value="8" />
    <Setter Property="CornerRadius" Value="4" />
  </Style>
</Styles>
