      <StreamGeometry x:Key="IconWarn">M1,21 H23 L12,2 Z M13,18 H11 V16 H13 Z M13,14 H11 V10 H13 Z</StreamGeometry>
      <StreamGeometry x:Key="IconFolder">M10,4 H4 C2.9,4 2,4.9 2,6 V18 C2,19.1 2.9,20 4,20 H20 C21.1,20 22,19.1 22,18 V8 C22,6.9 21.1,6 20,6 H12 Z</StreamGeometry>
