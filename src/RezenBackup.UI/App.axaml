<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="using:RezenBackup.UI"
             x:Class="RezenBackup.UI.App"
             Name="Rezen Backup"
             RequestedThemeVariant="Default">

  <Application.DataTemplates>
    <local:ViewLocator />
  </Application.DataTemplates>

  <Application.Resources>
    <ResourceDictionary>
      <ResourceDictionary.ThemeDictionaries>
        <ResourceDictionary x:Key="Light">
          <SolidColorBrush x:Key="RzWindowBg" Color="#F4F6FA" />
          <SolidColorBrush x:Key="RzSidebarBg" Color="#FFFFFF" />
          <SolidColorBrush x:Key="RzCardBg" Color="#FFFFFF" />
          <SolidColorBrush x:Key="RzCardBorder" Color="#E3E7EF" />
          <SolidColorBrush x:Key="RzText" Color="#0F172A" />
          <SolidColorBrush x:Key="RzMuted" Color="#5B667A" />
          <SolidColorBrush x:Key="RzAccent" Color="#1E6BFF" />
          <SolidColorBrush x:Key="RzAccentSoft" Color="#E8F0FF" />
          <SolidColorBrush x:Key="RzGood" Color="#0F9D58" />
          <SolidColorBrush x:Key="RzGoodSoft" Color="#E6F6EE" />
          <SolidColorBrush x:Key="RzWarn" Color="#B7791F" />
          <SolidColorBrush x:Key="RzWarnSoft" Color="#FFF6E5" />
          <SolidColorBrush x:Key="RzBad" Color="#C53030" />
          <SolidColorBrush x:Key="RzBadSoft" Color="#FDECEC" />
          <SolidColorBrush x:Key="RzNavSelected" Color="#E8F0FF" />
        </ResourceDictionary>
        <ResourceDictionary x:Key="Dark">
          <SolidColorBrush x:Key="RzWindowBg" Color="#0D1117" />
          <SolidColorBrush x:Key="RzSidebarBg" Color="#111722" />
          <SolidColorBrush x:Key="RzCardBg" Color="#161D2A" />
          <SolidColorBrush x:Key="RzCardBorder" Color="#243045" />
          <SolidColorBrush x:Key="RzText" Color="#E6EBF5" />
          <SolidColorBrush x:Key="RzMuted" Color="#93A0B8" />
          <SolidColorBrush x:Key="RzAccent" Color="#4C8DFF" />
          <SolidColorBrush x:Key="RzAccentSoft" Color="#17284A" />
          <SolidColorBrush x:Key="RzGood" Color="#3DD68C" />
          <SolidColorBrush x:Key="RzGoodSoft" Color="#12301F" />
          <SolidColorBrush x:Key="RzWarn" Color="#F0B95B" />
          <SolidColorBrush x:Key="RzWarnSoft" Color="#33270F" />
          <SolidColorBrush x:Key="RzBad" Color="#FF7070" />
          <SolidColorBrush x:Key="RzBadSoft" Color="#3A1717" />
          <SolidColorBrush x:Key="RzNavSelected" Color="#1A2B4D" />
        </ResourceDictionary>
      </ResourceDictionary.ThemeDictionaries>
      <Color x:Key="SystemAccentColor">#1E6BFF</Color>
      <Color x:Key="SystemAccentColorDark1">#1858D6</Color>
      <Color x:Key="SystemAccentColorLight1">#4C8DFF</Color>

