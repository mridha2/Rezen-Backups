<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>CFBundleName</key><string>Rezen Backup</string>
  <key>CFBundleDisplayName</key><string>Rezen Backup</string>
  <key>CFBundleIdentifier</key><string>com.rezen.backup</string>
  <key>CFBundleExecutable</key><string>RezenBackup</string>
  <key>CFBundleIconFile</key><string>rezen.icns</string>
  <key>CFBundlePackageType</key><string>APPL</string>
  <key>CFBundleShortVersionString</key><string>__VERSION__</string>
  <key>CFBundleVersion</key><string>__VERSION__</string>
  <key>LSMinimumSystemVersion</key><string>13.0</string>
  <key>NSHighResolutionCapable</key><true/>
  <!-- Every process starts without a Dock icon, so the background agent (same executable, --agent) never shows one.
       The main window process switches itself to a regular Dock app at startup (MacDock.ShowInDock). -->
  <key>LSUIElement</key><true/>
  <key>NSHumanReadableCopyright</key><string>Copyright © Rezen</string>
  <key>LSApplicationCategoryType</key><string>public.app-category.utilities</string>
  <!-- Rezen Backup never uses the network. -->
  <key>NSAppTransportSecurity</key><dict><key>NSAllowsArbitraryLoads</key><false/></dict>
</dict>
</plist>
